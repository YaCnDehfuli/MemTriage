# Copy to .env and adjust. docker-compose sets the service-to-service values
# itself; this file documents every knob and supports running the API/worker
# outside Docker. Every name below maps to a field in backend/memtriage/config.py.

# --- infrastructure ---
MEMTRIAGE_DATABASE_URL=postgresql+psycopg://memtriage:memtriage@localhost:5432/memtriage
MEMTRIAGE_REDIS_URL=redis://localhost:6379/0
MEMTRIAGE_DATA_DIR=/data

# --- API ---
MEMTRIAGE_CORS_ORIGINS=["http://localhost:5173"]

# --- upload / DoS limits ---
# 48 GiB default; 4GB+ dumps are first-class. Value is bytes.
MEMTRIAGE_MAX_UPLOAD_BYTES=51539607552
MEMTRIAGE_MAX_DUMPS_PER_INVESTIGATION=5

# --- per-process analysis guards ---
MEMTRIAGE_MAX_REGIONS_PER_PROCESS=512

# --- Volatility 3 ---
# Unset => VolMemLyzer auto-resolves `vol` / `vol.py` / `python -m volatility3`.
# MEMTRIAGE_VOL_PATH=/usr/local/bin/vol
MEMTRIAGE_VOL_TIMEOUT_S=1800

# --- VADViT model ---
# The trained checkpoint is not distributed with the project (see
# docs/MODEL_ACCESS.md). Drop it plus a labels.json under ./models to enable real
# verdicts; it takes precedence automatically.
MEMTRIAGE_MODEL_CHECKPOINT_PATH=/models/Multi_32_224_6f_3u.pt
MEMTRIAGE_LABELS_PATH=/models/labels.json
MEMTRIAGE_DEVICE=cpu

# When the trained checkpoint is absent, generate an architecturally identical
# untrained model once, from a fixed seed, into <DATA_DIR>/model_cache. Every
# stage still runs and every verdict is labelled as a non-detection. Set false to
# get an explicit "model not loaded" state instead.
MEMTRIAGE_MODEL_AUTO_PLACEHOLDER=true
MEMTRIAGE_PLACEHOLDER_SEED=20250817

# Shown in the app and in docs as the address to request trained weights from.
MEMTRIAGE_MODEL_CONTACT=yasindeh@yorku.ca

# --- grid geometry (VADViT preprocessing) ---
# Defaults match vit_base_patch32_224 + the 32_224 dataset. Switch to 16/384
# only if confirmed against real training PNGs.
MEMTRIAGE_PATCH_SIZE=32
MEMTRIAGE_IMAGE_SIZE=224

# --- assistant (phase 3) ---
# API keys are supplied per request by the analyst and are never read from the
# environment by the server. This flag only controls whether a self-hosted
# OpenAI-compatible gateway may be named as a target; every other provider is
# pinned to its own base URL. https, or a loopback address, only.
MEMTRIAGE_ALLOW_CUSTOM_LLM_BASE_URL=false
