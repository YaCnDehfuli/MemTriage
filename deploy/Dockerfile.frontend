# --- MemTriage frontend image ---
# Builds the Vite/React analyst workspace and serves the static bundle from nginx,
# reverse-proxying /api (including the SSE progress stream) to the API service.
FROM node:22-alpine AS build
WORKDIR /app

# Install deps first for layer caching.
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

COPY frontend/ ./
RUN npm run build

FROM nginx:1.31-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Non-root: the vhost listens on 8080 (compose publishes 127.0.0.1:5173:8080).
# Drop the master-config `user` directive so nginx does not try to setuid.
RUN sed -i '/^user /d' /etc/nginx/nginx.conf \
    && sed -i 's#/run/nginx.pid#/tmp/nginx.pid#' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
    && touch /tmp/nginx.pid && chown nginx:nginx /tmp/nginx.pid
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
